<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- Public DTO records defensively copy lists/maps in compact constructors. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    <Or>
      <Class name="~com\.ferricstore\..*Options" />
      <Class name="com.ferricstore.ChildSpec" />
      <Class name="com.ferricstore.CreateItem" />
      <Class name="com.ferricstore.FlowRecord" />
      <Class name="com.ferricstore.ClaimedItem" />
      <Class name="com.ferricstore.FlowMutationFields" />
      <Class name="com.ferricstore.PubSubMessage" />
      <Class name="com.ferricstore.RateLimitResult" />
    </Or>
  </Match>

  <!-- These classes intentionally hold or return long-lived SDK dependencies/helper handles. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    <Or>
      <Class name="com.ferricstore.FerricStoreClient" />
      <Class name="com.ferricstore.FerricStoreTransaction" />
      <Class name="com.ferricstore.JsonCodec" />
      <Class name="com.ferricstore.QueueClient" />
      <Class name="com.ferricstore.WorkflowClient" />
      <Class name="com.ferricstore.WorkflowContext" />
    </Or>
  </Match>

  <!-- AutoCloseable cleanup aggregates failures and intentionally rethrows unchecked errors. -->
  <Match>
    <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION" />
    <Or>
      <Class name="com.ferricstore.FerricStorePubSub" />
      <Class name="com.ferricstore.FerricStoreTransaction" />
    </Or>
  </Match>

  <!-- Raw HTTP details may contain non-serializable server values and are intentionally transient. -->
  <Match>
    <Bug pattern="SE_TRANSIENT_FIELD_NOT_RESTORED" />
    <Or>
      <Class name="com.ferricstore.HttpCommandException" />
      <Class name="com.ferricstore.HttpTransportException" />
    </Or>
  </Match>

  <!-- Negative contract tests intentionally pass null to verify public argument validation. -->
  <Match>
    <Bug pattern="NP_NULL_PARAM_DEREF_ALL_TARGETS_DANGEROUS" />
    <Class name="~com\.ferricstore\..*Test" />
  </Match>

  <!-- List.copyOf validates while snapshotting; translate its NPE to the public indexed error. -->
  <Match>
    <Bug pattern="DCN_NULLPOINTER_EXCEPTION" />
    <Class name="com.ferricstore.FerricStoreClient" />
    <Method name="copyArgs" />
  </Match>

  <!-- Spring Boot's JavaBean configuration binder requires mutable nested property handles. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    <Class name="~com\.ferricstore\.spring\.FerricStoreProperties.*" />
  </Match>

  <!-- Null marks absent values or an unsupported compact fast path, not empty byte arrays. -->
  <Match>
    <Bug pattern="PZLA_PREFER_ZERO_LENGTH_ARRAYS" />
    <Or>
      <Class name="com.ferricstore.JsonCodec" />
      <Class name="com.ferricstore.FlowCreatePipeline" />
      <Class name="com.ferricstore.NativeFlowPipelineCodec" />
      <Class name="com.ferricstore.NativeFlowManyCodec" />
      <Class name="com.ferricstore.NativePipelineCodec" />
      <Class name="com.ferricstore.NativeFlowManyCodecTest" />
      <Class name="com.ferricstore.RawCodec" />
      <Class name="com.ferricstore.Resp" />
    </Or>
  </Match>

  <!-- Queue/workflow handlers are user extension points and may throw arbitrary failures. -->
  <Match>
    <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION" />
    <Or>
      <Class name="com.ferricstore.QueueHandler" />
      <Class name="com.ferricstore.WorkflowHandler" />
      <Class name="com.ferricstore.AsyncWorkflowHandler" />
    </Or>
  </Match>

  <!-- Test methods intentionally share JUnit's broad checked-exception boundary. -->
  <Match>
    <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION" />
    <Class name="~com\.ferricstore\..*Test" />
  </Match>

  <!-- The assembler synchronizes on its private pending map; pending requests use CHM. -->
  <Match>
    <Bug pattern="AT_UNSAFE_RESOURCE_ACCESS_IN_THREAD" />
    <Class name="com.ferricstore.NativeExecutor" />
  </Match>

  <!-- Protocol, durable-worker, and future failures deliberately cross runtime-only boundaries. -->
  <Match>
    <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION" />
    <Or>
      <Class name="com.ferricstore.AsyncFutures" />
      <Class name="com.ferricstore.NativeExecutor" />
      <Class name="com.ferricstore.NativeResponseAssembler" />
      <Class name="com.ferricstore.WorkerExecutors" />
      <Class name="com.ferricstore.WorkflowWorker" />
      <Class name="com.ferricstore.DurableStepTest$ScriptedExecutor" />
      <Class name="com.ferricstore.FerricStoreWorkerTest$WorkerExecutor" />
      <Class name="com.ferricstore.WorkflowDurableStepTest$WorkerExecutor" />
      <Class name="~com\.ferricstore\.examples\.ProtocolWorkflowBenchmark.*" />
    </Or>
  </Match>

  <!-- This test double intentionally returns its controllable future to model cancellation. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP" />
    <Class name="com.ferricstore.WorkflowDurableStepTest$PausingExecutor" />
  </Match>

  <!-- Nullable metadata mirrors optional server fields; raw wire detail is transient by design. -->
  <Match>
    <Bug pattern="NP_BOOLEAN_RETURN_NULL,SE_TRANSIENT_FIELD_NOT_RESTORED" />
    <Class name="com.ferricstore.NativeServerException" />
  </Match>

  <!-- ReentrantLock is acquired immediately before the try/finally; the detector misses lock(). -->
  <Match>
    <Bug pattern="CWO_CLOSED_WITHOUT_OPENED" />
    <Class name="com.ferricstore.WorkerSessionRuntime" />
  </Match>

  <!-- The response-loss proxy deliberately closes both tunnel ends and ignores close races. -->
  <Match>
    <Bug pattern="DE_MIGHT_IGNORE" />
    <Class name="com.ferricstore.ResponseDropProxy" />
    <Method name="closeQuietly" />
  </Match>
</FindBugsFilter>
